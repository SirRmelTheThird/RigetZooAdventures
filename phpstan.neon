includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8

    paths:
        - src
        - tests

    bootstrapFiles:
        - vendor/autoload.php

    tmpDir: var/phpstan

    # This project uses standalone Eloquent with Capsule,
    # not a full Laravel application.
    disableMigrationScan: true
    disableSchemaScan: true