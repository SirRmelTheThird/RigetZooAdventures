{
    "name": "riget/zoo-adventures",
    "description": "Zoo booking system with Eloquent ORM",
    "type": "project",
    "license": "MIT",
    "scripts": {
        "lint": "phpcs --standard=PSR12 src tests",
        "format": "php-cs-fixer fix src tests",
        "format:check": "php-cs-fixer fix --dry-run --diff src tests",
        "analyse": "phpstan analyse src tests",
        "test": "phpunit"
    },
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "illuminate/database": "^11.0",
        "stripe/stripe-php": "^19.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "autoload": {
        "psr-4": {
            "": "src/",
            "Config\\": "config/",
            "Database\\Migrations\\": "database/migrations/",
            "Database\\Seeders\\": "database/seeders/",
            "Tests\\Support\\": "tests/Support/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3",
        "squizlabs/php_codesniffer": "^4.0"
    }
}
