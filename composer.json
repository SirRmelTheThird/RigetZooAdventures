{
    "name": "riget/zoo-adventures",
    "description": "Zoo booking system with Eloquent ORM",
    "type": "project",
    "license": "MIT",
    "scripts": {
        "lint": "phpcs --standard=PSR12 src tests",
        "format": "php-cs-fixer fix src tests",
        "format:check": "php-cs-fixer fix --dry-run --diff src tests",
        "analyse": "phpstan analyse src tests",
        "test": "phpunit"
    },
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "illuminate/database": "^11.0",
        "ramsey/uuid": "^4.9",
        "stripe/stripe-php": "^19.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "autoload": {
        "psr-4": {
            "Config\\": "config/",
            "Bootstrap\\": "src/Bootstrap/",
            "Controllers\\": "src/Controllers/",
            "Contracts\\": "src/Contracts/",
            "Content\\": "src/Content/",
            "Cart\\": "src/Cart/",
            "Core\\": "src/Core/",
            "Enums\\": "src/Enums/",
            "Factories\\": "src/Factories/",
            "DTOs\\": "src/DTOs/",
            "Exceptions\\": "src/Exceptions/",
            "Middleware\\": "src/Middleware/",
            "Models\\": "src/Models/",
            "Payments\\": "src/Payments/",
            "Repositories\\": "src/Repositories/",
            "Requests\\": "src/Requests/",
            "Services\\": "src/Services/",
            "Support\\": "src/Support/",
            "Database\\Migrations\\": "database/migrations/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "larastan/larastan": "3.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3",
        "squizlabs/php_codesniffer": "^4.0"
    }
}
